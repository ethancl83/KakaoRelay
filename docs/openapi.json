  "components": {
    "securitySchemes": {
      "localBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "앱이 매 실행 생성하는 connection.json의 token. 외부에 출력하지 마세요."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "SendCommand": {
        "type": "object",
        "required": [
          "requestId",
          "recipient",
          "message"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "description": "동일 작업의 재시도에는 동일 ID"
          },
          "recipient": {
            "type": "string",
            "description": "rooms의 정확한 title"
          },
          "message": {
            "type": "string",
            "description": "본문. 줄바꿈 지원. 임의 글자 수 제한 없음. 공백뿐인 본문 및 NUL 금지."
          },
          "imagePath": {
            "type": "string",
            "description": "PC 로컬 이미지 절대 경로. PNG/JPEG/GIF/BMP/WebP."
          },
          "attachment": {
            "$ref": "#/components/schemas/PersonaAttachment"
          }
        }
      },
      "Room": {
        "type": "object",
        "required": [
          "title",
          "processId",
          "handle",
          "ambiguous",
          "selectable",
          "hint"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "processId": {
            "type": "integer"
          },
          "handle": {
            "type": "string"
          },
          "ambiguous": {
            "type": "boolean"
          },
          "selectable": {
            "type": "boolean"
          },
          "hint": {
            "type": "string"
          }
        }
      },
      "Receipt": {
        "type": "object",
        "required": [
          "requestId",
          "recipient",
          "fingerprint",
          "status",
          "enterPosted",
          "inputCleared",
          "startedAt",
          "finishedAt",
          "detail",
          "foregroundBefore",
          "foregroundAfter"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "recipient": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "prepared",
              "inputting",
              "dispatching",
              "blocked-before-input",
              "needs-review",
              "observed-in-chat",
              "continued-after-visual-review"
            ]
          },
          "enterPosted": {
            "type": "boolean",
            "description": "Enter 요청 큐 등록. 수신 확인 아님"
          },
          "inputCleared": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "detail": {
            "type": "string"
          },
          "foregroundBefore": {
            "type": "string"
          },
          "foregroundAfter": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "text",
              "image"
            ]
          },
          "attachmentQueued": {
            "type": "boolean",
            "description": "파일 첨부 요청 완료. 발송 성공 증거가 아님."
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "send": {
            "const": true
          },
          "idempotency": {
            "const": "requestId"
          },
          "requiresOpenRoom": {
            "const": true
          },
          "maxMessageCharacters": {
            "type": "null"
          },
          "recentMessages": {
            "type": "object",
            "properties": {
              "supported": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              }
            }
          },
          "deliveryVerification": {
            "const": "manual"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aiChat": {
            "type": "boolean"
          }
        }
      },
      "LocalRoom": {
        "type": "object",
        "required": [
          "profile",
          "id",
          "title",
          "readable"
        ],
        "properties": {
          "profile": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "readable": {
            "type": "boolean"
          }
        }
      },
      "LocalMessage": {
        "type": "object",
        "required": [
          "id",
          "authorId",
          "author",
          "time",
          "type",
          "text",
          "deleted"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "authorId": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean"
          }
        }
      },
      "ChatContext": {
        "type": "object",
        "required": [
          "room",
          "messages",
          "readAt"
        ],
        "properties": {
          "room": {
            "$ref": "#/components/schemas/LocalRoom"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocalMessage"
            }
          },
          "readAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BotPersona": {
        "type": "object",
        "required": [
          "name",
          "role",
          "tone",
          "style",
          "instructions"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "tone": {
            "type": "string"
          },
          "style": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          }
        }
      },
      "AiProvider": {
        "type": "object",
        "required": [
          "id",
          "enabled",
          "executable",
          "model",
          "effort"
        ],
        "properties": {
          "id": {
            "enum": [
              "codex",
              "grok",
              "claude"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "executable": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "effort": {
            "type": "string"
          }
        }
      },
      "AiSettings": {
        "type": "object",
        "required": [
          "provider",
          "contextMessages",
          "timeoutSeconds",
          "persona",
          "providers"
        ],
        "properties": {
          "provider": {
            "enum": [
              "auto",
              "codex",
              "grok",
              "claude"
            ]
          },
          "contextMessages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 900
          },
          "persona": {
            "$ref": "#/components/schemas/BotPersona"
          },
          "providers": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/AiProvider"
            }
          },
          "personas": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/PersonaProfile"
            }
          },
          "roomPersonas": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "JSON.stringify([profile, roomId]) 키 → personaId"
          },
          "roomReplyModes": {
            "type": "object",
            "description": "JSON.stringify([profile, roomId]) 키로 저장하는 방별 답변 방식. 없으면 이전 replyMode 설정 사용.",
            "additionalProperties": {
              "enum": [
                "immediate",
                "trigger",
                "context"
              ],
              "type": "string"
            }
          }
        }
      },
      "AiCommand": {
        "type": "object",
        "required": [
          "profile",
          "roomId"
        ],
        "properties": {
          "profile": {
            "type": "string"
          },
          "roomId": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "analyze",
              "reply",
              "chat"
            ],
            "default": "analyze"
          },
          "instruction": {
            "type": "string",
            "maxLength": 10000,
            "default": ""
          }
        }
      },
      "AiResult": {
        "type": "object",
        "required": [
          "text",
          "provider",
          "model",
          "effort",
          "mode",
          "room",
          "messageCount",
          "attempts"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "effort": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "room": {
            "$ref": "#/components/schemas/LocalRoom"
          },
          "messageCount": {
            "type": "integer"
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "provider",
                "status"
              ],
              "properties": {
                "provider": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          },
          "personaId": {
            "type": "string"
          },
          "emotion": {
            "type": "string"
          },
          "attachment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PersonaAttachment"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "CliStatus": {
        "type": "object",
        "required": [
          "provider",
          "installed",
          "path",
          "detail"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "installed": {
            "type": "boolean"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "PersonaAttachment": {
        "type": "object",
        "required": [
          "personaId",
          "provider",
          "imageId"
        ],
        "properties": {
          "personaId": {
            "type": "string"
          },
          "provider": {
            "enum": [
              "astra",
              "grok"
            ]
          },
          "imageId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{32}$"
          }
        }
      },
      "ImageCommand": {
        "type": "object",
        "required": [
          "requestId",
          "recipient"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "description": "동일 작업의 재시도에는 동일 ID"
          },
          "recipient": {
            "type": "string",
            "description": "rooms의 정확한 title"
          },
          "imagePath": {
            "type": "string",
            "description": "PC 로컬 이미지 절대 경로. PNG/JPEG/GIF/BMP/WebP."
          },
          "attachment": {
            "$ref": "#/components/schemas/PersonaAttachment"
          }
        },
        "oneOf": [
          {
            "required": [
              "imagePath"
            ],
            "not": {
              "required": [
                "attachment"
              ]
            }
          },
          {
            "required": [
              "attachment"
            ],
            "not": {
              "required": [
                "imagePath"
              ]
            }
          }
        ]
      },
      "PersonaProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "persona": {
            "$ref": "#/components/schemas/BotPersona"
          },
          "attachImages": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
