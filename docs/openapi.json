{
  "openapi": "3.1.0",
  "info": {
    "title": "KakaoRelay Local Gateway",
    "version": "0.7.4",
    "description": "인증된 로컬 Windows 게이트웨이. 메시지 전송, SQLCipher 4 로컬 대화 읽기, CLI AI 분석·페르소나 설정."
  },
  "security": [
    {
      "localBearer": []
