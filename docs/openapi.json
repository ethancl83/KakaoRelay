{
  "openapi": "3.1.0",
  "info": {
    "title": "KakaoRelay Local Gateway",
    "version": "0.5.0",
    "description": "앱과 같은 프로세스의 로컬 API. %LOCALAPPDATA%/KakaoRelay/connection.json에서 baseUrl과 token을 읽습니다. 글자 수 제한 없음. 같은 작업은 동일 requestId 사용. 최근 메시지 읽기는 현재 미지원."
  },
  "security": [
    {
      "localBearer": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "실행 상태",
        "responses": {
          "200": {
            "description": "처리 결과. HTTP 200만으로 발송 완료를 판단하지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "version",
                    "application"
                  ],
                  "properties": {
                    "status": {
                      "const": "ready"
                    },
                    "version": {
                      "type": "string"
                    },
                    "application": {
                      "const": "KakaoRelay"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "summary": "지원 기능",
        "responses": {
          "200": {
            "description": "처리 결과. HTTP 200만으로 발송 완료를 판단하지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "400": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/rooms": {
      "get": {
        "operationId": "listRooms",
        "summary": "열린 대화방 조회",
        "responses": {
          "200": {
            "description": "처리 결과. HTTP 200만으로 발송 완료를 판단하지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Room"
                  }
                }
              }
            }
          },
          "400": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/send": {
      "post": {
        "operationId": "sendMessage",
        "summary": "앱을 통해 메시지 발송",
        "description": "같은 requestId와 같은 본문은 기존 결과 반환. 이름이 정확히 일치하는 열린 방 하나만 허용. 자동 재전송 없음.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "처리 결과. HTTP 200만으로 발송 완료를 판단하지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/requests": {
      "get": {
        "operationId": "listRequests",
        "summary": "발송 기록 조회 (본문 제외)",
        "responses": {
          "200": {
            "description": "처리 결과. HTTP 200만으로 발송 완료를 판단하지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Receipt"
                  }
                }
              }
            }
          },
          "400": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/requests/{requestId}": {
      "get": {
        "operationId": "getRequest",
        "summary": "요청별 결과 조회",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "처리 결과. HTTP 200만으로 발송 완료를 판단하지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "기록 없음은 미발송의 증거가 아닙니다. 같은 요청 ID를 유지하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "오류 code/detail을 확인하세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "localBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "앱이 매 실행 생성하는 connection.json의 token. 외부에 출력하지 마세요."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "SendCommand": {
        "type": "object",
        "required": [
          "requestId",
          "recipient",
          "message"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "description": "동일 작업의 재시도에는 동일 ID"
          },
          "recipient": {
            "type": "string",
            "description": "rooms의 정확한 title"
          },
          "message": {
            "type": "string",
            "description": "본문. 줄바꿈 지원. 임의 글자 수 제한 없음. 공백뿐인 본문 및 NUL 금지."
          }
        }
      },
      "Room": {
        "type": "object",
        "required": [
          "title",
          "processId",
          "handle",
          "ambiguous",
          "selectable",
          "hint"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "processId": {
            "type": "integer"
          },
          "handle": {
            "type": "string"
          },
          "ambiguous": {
            "type": "boolean"
          },
          "selectable": {
            "type": "boolean"
          },
          "hint": {
            "type": "string"
          }
        }
      },
      "Receipt": {
        "type": "object",
        "required": [
          "requestId",
          "recipient",
          "fingerprint",
          "status",
          "enterPosted",
          "inputCleared",
          "startedAt",
          "finishedAt",
          "detail",
          "foregroundBefore",
          "foregroundAfter"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "recipient": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "prepared",
              "inputting",
              "dispatching",
              "blocked-before-input",
              "needs-review",
              "observed-in-chat",
              "continued-after-visual-review"
            ]
          },
          "enterPosted": {
            "type": "boolean",
            "description": "Enter 요청 큐 등록. 수신 확인 아님"
          },
          "inputCleared": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "detail": {
            "type": "string"
          },
          "foregroundBefore": {
            "type": "string"
          },
          "foregroundAfter": {
            "type": "string"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "send": {
            "const": true
          },
          "idempotency": {
            "const": "requestId"
          },
          "requiresOpenRoom": {
            "const": true
          },
          "maxMessageCharacters": {
            "type": "null"
          },
          "recentMessages": {
            "type": "object",
            "properties": {
              "supported": {
                "const": false
              },
              "reason": {
                "type": "string"
              }
            }
          },
          "deliveryVerification": {
            "const": "manual"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
