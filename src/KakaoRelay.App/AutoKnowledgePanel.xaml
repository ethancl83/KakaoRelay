<UserControl x:Class="KakaoRelay.App.AutoKnowledgePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="120" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="대화를 지식 노트로 자동 정리" FontWeight="SemiBold" />
      <TextBlock Text="매 주기마다 마지막 처리 위치부터 최근 대화까지 확인합니다. 잡담은 생략하고 기존 노트와 중복·충돌을 비교해 지식·결정·할 일을 저장합니다. 앱이 켜져 있어야 합니다." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8" />
      <CheckBox Content="대화 자동 정리 사용" IsChecked="{Binding Enabled}" Margin="0,4,0,10" />
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <Button Content="방 새로고침" Click="Refresh_Click" IsEnabled="{Binding CanConfigure}" DockPanel.Dock="Right" Padding="10,6" />
      <TextBlock Text="정리 주기(분)" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Text="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Left" Padding="8,5" AutomationProperties.Name="대화 자동 정리 주기" />
    </DockPanel>
    <ListBox Grid.Row="2" ItemsSource="{Binding Rooms}" BorderBrush="#D2DFE2" IsEnabled="{Binding CanConfigure}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="자동 정리할 대화방">
      <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}"><StackPanel Margin="2,5"><TextBlock Text="{Binding Title}" /><TextBlock Text="{Binding Destination}" FontSize="10" Foreground="{StaticResource Muted}" /></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="3" Margin="0,10,0,0">
      <CheckBox Content="확인된 내용은 지식으로 바로 저장" IsChecked="{Binding AutoSave}" />
      <TextBlock Text="해제하면 전부 검토필요 폴더에 저장합니다. 추측·충돌하는 내용은 항상 검토 대상으로 분리하고 봇 검색에서 제외합니다. 봇 발신 계정의 모든 메시지와 첨부파일은 제외합니다." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,10" />
      <WrapPanel>
        <Button Content="설정 적용" Click="Apply_Click" IsEnabled="{Binding CanConfigure}" Padding="10,7" Margin="0,0,6,6" Background="#087E83" Foreground="White" />
        <Button Content="지금 정리" Click="Run_Click" IsEnabled="{Binding CanRun}" Padding="10,7" Margin="0,0,6,6" />
        <Button Content="검토 폴더" Click="Review_Click" Padding="10,7" Margin="0,0,0,6" />
      </WrapPanel>
    </StackPanel>
    <TextBlock Grid.Row="4" Text="방에 연결된 봇의 보관함에 저장합니다. 새 대화와 짧은 근거 인용이 선택된 AI 서비스로 전달됩니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,8" />
    <TextBox Grid.Row="5" Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="86" Padding="8" Background="#F1F7F7" BorderThickness="0" FontSize="11" AutomationProperties.Name="대화 자동 정리 상태" />
  </Grid>
  </ScrollViewer>
</UserControl>
