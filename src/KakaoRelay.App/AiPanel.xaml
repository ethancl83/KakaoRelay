<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:KakaoRelay.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="KakaoRelay.App.AiPanel">
  <UserControl.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="Margin" Value="0,4,0,10" />
      <Setter Property="BorderBrush" Value="#D2DFE2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,4,0,10" />
    </Style>
    <local:RoomPersonaNameConverter x:Key="RoomPersonaName" />
    <local:RoomReplyModeConverter x:Key="RoomReplyMode" />
    <DataTemplate x:Key="RoomWithPersona">
      <Grid Margin="2,4" ToolTip="{Binding Display}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
        <Border x:Name="Chip" Grid.Column="1" Background="#E2F3F0" CornerRadius="9" Padding="8,3" Margin="8,0,0,0" MaxWidth="125">
          <TextBlock x:Name="ChipText" Foreground="#086D65" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
            <TextBlock.Text>
              <MultiBinding Converter="{StaticResource RoomPersonaName}">
                <Binding />
                <Binding Path="DataContext.Settings" RelativeSource="{RelativeSource AncestorType=local:AiPanel}" />
                <Binding Path="DataContext.PersonaBindingsRevision" RelativeSource="{RelativeSource AncestorType=local:AiPanel}" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </Border>
        <Border Grid.Column="2" Background="#EEF0F8" CornerRadius="9" Padding="8,3" Margin="6,0,0,0" ToolTip="이 방의 답변 방식">
          <TextBlock Foreground="#4D587A" FontSize="11" TextWrapping="NoWrap">
            <TextBlock.Text>
              <MultiBinding Converter="{StaticResource RoomReplyMode}">
                <Binding />
                <Binding Path="DataContext.Settings" RelativeSource="{RelativeSource AncestorType=local:AiPanel}" />
                <Binding Path="DataContext.PersonaBindingsRevision" RelativeSource="{RelativeSource AncestorType=local:AiPanel}" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <Trigger SourceName="ChipText" Property="Text" Value="">
          <Setter TargetName="Chip" Property="Visibility" Value="Collapsed" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>
  <Grid Margin="0,12,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10">
      <Button Content="설정 저장" DockPanel.Dock="Right" Click="Save_Click" IsEnabled="{Binding Idle}" Padding="12,7" />
      <Image Source="{Binding Avatar}" Width="44" Height="44" Margin="0,0,10,0" DockPanel.Dock="Left" />
      <StackPanel>
        <TextBlock Text="AI 챗봇" FontSize="19" FontWeight="Bold" />
      </StackPanel>
    </DockPanel>
    <TabControl Grid.Row="1" BorderBrush="#D2DFE2" x:Name="AiTabs">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Padding" Value="8,8" />
        </Style>
      </TabControl.Resources>
      <TabItem Header="자동답장">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid IsEnabled="{Binding CanStartBots}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0"><TextBlock Text="폴링(초)" FontSize="11"/><TextBox Text="{Binding Settings.PollSeconds, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="대화방 폴링 간격" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="카카오 ID" FontSize="11"/><TextBox Text="{Binding SelfId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="내 카카오 사용자 ID" Margin="0,4,0,0"/></StackPanel>
            <Button Grid.Column="2" Content="방 새로고침" Click="Rooms_Click" VerticalAlignment="Bottom" Padding="10,8"/>
          </Grid>
          <ListBox x:Name="BotRooms" Grid.Row="1" ItemsSource="{Binding Rooms}" SelectionMode="Multiple" IsEnabled="{Binding CanStartBots}" Margin="0,10" ItemTemplate="{StaticResource RoomWithPersona}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ToolTip="자동답장할 방을 최대 3개 선택하세요."/>
          <Grid Grid.Row="2" IsEnabled="{Binding CanBindBot}" ToolTip="{Binding BotBindingRoom.Title}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="132"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,6,0"><TextBlock Text="봇" FontSize="11"/><ComboBox ItemsSource="{Binding Settings.Personas}" SelectedItem="{Binding RoomProfile}" DisplayMemberPath="Persona.Name" AutomationProperties.Name="연결할 봇" Padding="4,6" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,6,0"><TextBlock Text="답변 방식" FontSize="11"/><ComboBox ItemsSource="{Binding ReplyModes}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding RoomReplyMode}" AutomationProperties.Name="선택한 방의 답변 방식" Padding="4,6" Margin="0,4,0,0"/></StackPanel>
            <Button Grid.Column="2" Content="연결" Click="BindPersona_Click" Padding="9,8" VerticalAlignment="Bottom"/>
          </Grid>
          <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button Content="중지" Click="StopBots_Click" IsEnabled="{Binding BotsRunning}" DockPanel.Dock="Right" Padding="16,8" Margin="8,0,0,0"/>
            <Button Content="자동답장 시작" Click="StartBot_Click" IsEnabled="{Binding CanStartBots}" Background="#087E83" Foreground="White" Padding="16,8"/>
          </DockPanel>
          <ItemsControl Grid.Row="4" ItemsSource="{Binding BotStatuses}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" ToolTip="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </TabItem>
      <TabItem Header="페르소나">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="편집할 페르소나 · 3개를 미리 설정하세요" />
            <ComboBox ItemsSource="{Binding Settings.Personas}" SelectedItem="{Binding EditingProfile}" DisplayMemberPath="Persona.Name" IsEnabled="{Binding CanEditPersona}" />
          </StackPanel>
          <TabControl Grid.Row="1" BorderThickness="0">
            <TabItem Header="성격 · 지침">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12" IsEnabled="{Binding Idle}">
                  <TextBlock Text="봇 이름" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding EditingProfile.Persona.Name, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Grid.Column="1" Content="이미지 첨부" IsChecked="{Binding EditingProfile.AttachImages}" VerticalAlignment="Center" Margin="12,0,0,6" ToolTip="감정이 드러나는 답변에만 감정 이미지를 보냅니다. 감정 없는 답변은 방별로 오늘 첫 답장일 때만 기본 이미지를 보냅니다." />
                  </Grid>
                  <TextBlock Text="역할" />
                  <TextBox Text="{Binding EditingProfile.Persona.Role, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                  <TextBlock Text="말투" />
                  <TextBox Text="{Binding EditingProfile.Persona.Tone, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Text="대화 성향 · 답변 길이" />
                  <TextBox Text="{Binding EditingProfile.Persona.Style, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" />
                  <TextBlock Text="추가 지침" />
                  <TextBox Text="{Binding EditingProfile.Persona.Instructions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="95" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="이미지">
              <local:PersonaImagesPanel x:Name="PersonaImages" />
            </TabItem>
            <TabItem Header="지식베이스">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12" IsEnabled="{Binding Idle}">
                  <TextBlock Text="옵시디언 보관함" FontWeight="SemiBold" />
                  <TextBlock Text="이 페르소나를 사용하는 방에서 관련 노트를 참고합니다. 공유할 노트만 담은 보관함 또는 하위 폴더를 선택하세요." FontSize="11" Margin="0,6" />
                  <TextBox Text="{Binding EditingProfile.Knowledge.VaultPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="옵시디언 보관함 경로" />
                  <WrapPanel>
                    <Button Content="폴더 선택" Click="KnowledgeFolder_Click" Padding="10,6" Margin="0,0,6,0" />
                    <Button Content="폴더 열기" Click="KnowledgeOpen_Click" Padding="10,6" />
                  </WrapPanel>
                  <CheckBox Content="답변에 지식 노트 사용" IsChecked="{Binding EditingProfile.Knowledge.Enabled}" Margin="0,12" />
                  <TextBlock Text="관련 노트의 발췌는 AI 서비스에 전달됩니다. 노트 수정·삭제는 다음 요청부터 반영됩니다. 대화분석 결과는 검토 후 ‘요약을 노트로 저장’으로 쌓을 수 있습니다." FontSize="11" Foreground="{StaticResource Muted}" />
                  <TextBlock Text="검색 미리보기" Margin="0,16,0,0" FontWeight="SemiBold" />
                  <TextBox Text="{Binding KnowledgeQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="지식 검색어" />
                  <Button Content="관련 노트 확인" Click="KnowledgeSearch_Click" HorizontalAlignment="Left" Padding="10,6" />
                  <TextBox Text="{Binding KnowledgePreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="150" AutomationProperties.Name="지식 검색 결과" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </TabItem>
      <TabItem Header="프로바이더">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12" IsEnabled="{Binding Idle}">
            <TextBlock Text="먼저 사용할 프로바이더" />
            <ComboBox ItemsSource="{Binding ProviderChoices}" SelectedItem="{Binding Settings.Provider}" />
            <TextBlock Text="auto는 Codex부터, 직접 선택하면 해당 프로바이더부터 시작합니다. 실패하면 Codex → Grok → Claude → Codex 순환으로 최대 2회전 후 종료합니다. 사용 안 함은 건너뜁니다." FontSize="11" Foreground="{StaticResource Muted}" />
            <ItemsControl ItemsSource="{Binding Settings.Providers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#D2DFE2" BorderThickness="1" CornerRadius="7" Padding="8" Margin="0,8,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="83" />
                      </Grid.ColumnDefinitions>
                      <CheckBox Content="{Binding Id}" IsChecked="{Binding Enabled}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding ModelChoices}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="AI 모델" ToolTip="모델 · 비우면 CLI 기본값" Margin="0,0,6,0" />
                      <ComboBox Grid.Column="2" IsEditable="True" Text="{Binding Effort, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.EffortChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="AI effort" Margin="0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="지원하는 모델과 effort는 CLI 버전·로그인 계정에 따라 다릅니다. Grok은 xAI Grok Build, Claude는 Claude Code를 사용합니다." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10" />
            <Grid Margin="0,6,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="메시지 수" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding Settings.ContextMessages, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />
              <TextBlock Grid.Column="2" Text="제한(초)" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="3" Text="{Binding Settings.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
            </Grid>
            <Button Content="CLI 설치 확인" Click="Detect_Click" HorizontalAlignment="Left" Padding="12,7" />
            <TextBlock Text="{Binding CliInfo}" FontSize="11" Margin="0,8" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="대화분석">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel IsEnabled="{Binding Idle}">
            <Button Content="방 새로고침" DockPanel.Dock="Right" Click="Rooms_Click" Padding="10,7" Margin="8,0,0,8" />
            <ComboBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" AutomationProperties.Name="AI 대화방" ItemTemplate="{StaticResource RoomWithPersona}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
          </DockPanel>
          <DockPanel Grid.Row="1">
            <Button Content="JSON 저장" Click="Export_Click" IsEnabled="{Binding CanRead}" Padding="10,6" DockPanel.Dock="Right" Margin="6,0,0,0" />
            <Button Content="대화 읽기" Click="Read_Click" IsEnabled="{Binding CanRead}" Padding="10,6" DockPanel.Dock="Right" />
            <TextBlock Text="{Binding ContextHint}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBox Grid.Row="2" Text="{Binding Transcript, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="60" FontSize="11" Background="#FAFCFC" AutomationProperties.Name="읽은 대화" />
          <StackPanel Grid.Row="3">
            <TextBlock Text="질문 · 답변에 반영할 요청 (선택)" FontSize="11" Foreground="{StaticResource Muted}" />
            <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Idle}" AcceptsReturn="True" TextWrapping="Wrap" Height="55" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="AI 질문" />
          </StackPanel>
          <WrapPanel Grid.Row="4">
            <Button Content="대화 분석" Tag="analyze" Click="Generate_Click" IsEnabled="{Binding CanRead}" Padding="10,7" Margin="0,0,6,0" />
            <Button Content="답변 만들기" Tag="reply" Click="Generate_Click" IsEnabled="{Binding CanRead}" Padding="10,7" Margin="0,0,6,0" />
            <Button Content="질문하기" Tag="chat" Click="Generate_Click" IsEnabled="{Binding CanRead}" Padding="10,7" Margin="0,0,6,0" />
            <Button Content="취소" Click="Cancel_Click" IsEnabled="{Binding Busy}" Padding="10,7" />
          </WrapPanel>
          <Grid Grid.Row="5">
            <TextBox Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Busy}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="70" AutomationProperties.Name="AI 응답" />
            <TextBlock Text="응답을 기다리는 중입니다. 완료되면 여기에 표시됩니다." Visibility="{Binding AnswerWaitingVisibility}" Background="White" Foreground="{StaticResource Muted}" VerticalAlignment="Top" Margin="12,14" TextWrapping="Wrap" IsHitTestVisible="False" />
          </Grid>
          <StackPanel Grid.Row="6">
            <Button Content="요약을 노트로 저장" Click="SaveKnowledgeNote_Click" IsEnabled="{Binding CanSaveKnowledgeNote}" HorizontalAlignment="Left" Padding="10,7" Margin="0,0,0,6" ToolTip="대화 분석 결과를 검토·수정한 뒤 해당 방의 페르소나 보관함에 저장합니다." />
          <DockPanel>
            <Button Content="발송란으로 가져오기" Click="Compose_Click" IsEnabled="{Binding CanCompose}" DockPanel.Dock="Right" Padding="10,7" />
            <TextBlock Text="선택한 방의 최근 대화가 선택된 AI 서비스로 전달됩니다. 자동 선택은 Codex → Grok → Claude 순서입니다." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
          </DockPanel>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#EAF5F5" Padding="10" Margin="0,9,0,0" CornerRadius="6">
      <StackPanel>
        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,6" Visibility="{Binding ProgressVisibility}" />
        <TextBlock Text="{Binding Activity}" ToolTip="{Binding Activity}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
