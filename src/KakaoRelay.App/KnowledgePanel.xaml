<UserControl x:Class="KakaoRelay.App.KnowledgePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:KakaoRelay.App">
  <UserControl.Resources>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="0,5,0,8" /></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="14,7" /></Style>
  </UserControl.Resources>
  <Grid Margin="0,12,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <DockPanel>
        <TextBlock Text="사용할 봇" VerticalAlignment="Center" Margin="0,0,12,0" />
        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" DisplayMemberPath="Persona.Name" IsEnabled="{Binding Idle}" Padding="8,6" AutomationProperties.Name="지식베이스 봇" />
      </DockPanel>
      <TextBlock Text="{Binding ConnectionHint}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,10" />
    </StackPanel>
    <TabControl Grid.Row="1" BorderBrush="#D2DFE2" IsEnabled="{Binding Idle}">
      <TabItem Header="자료">
        <Grid Margin="10" AllowDrop="True" PreviewDragOver="Files_DragOver" Drop="Files_Drop">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="140" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel>
            <Button Content="새로고침" DockPanel.Dock="Right" Click="Refresh_Click" Padding="10,7" />
            <StackPanel Orientation="Horizontal">
              <Button Content="자료 추가" Click="Upload_Click" Padding="12,7" Background="#087E83" Foreground="White" Margin="0,0,6,0" />
              <Button Content="직접 쓰기" Click="Write_Click" Padding="10,7" />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Background="#F1F7F7" CornerRadius="7" Padding="12" Margin="0,10">
            <StackPanel>
              <TextBlock Text="파일을 여기에 끌어 놓으세요" FontWeight="SemiBold" />
              <TextBlock Text="MD · TXT · PDF · Word(DOCX), 파일당 20MB&#x0a;텍스트를 노트로 저장합니다. 스캔 PDF는 문자 인식이 필요합니다." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <DockPanel Grid.Row="2">
            <Button Content="검색" DockPanel.Dock="Right" Click="Search_Click" Padding="10,7" Margin="6,0,0,8" />
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" AutomationProperties.Name="지식 검색어" ToolTip="관련 내용을 검색합니다. AI 호출 없이 로컬에서 확인합니다." KeyDown="Search_KeyDown" />
          </DockPanel>
          <ListBox Grid.Row="3" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="지식 노트 목록">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Source}" Margin="3,4" /></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <DockPanel Grid.Row="4" Margin="0,8,0,4">
            <Button Content="옵시디언에서 편집" DockPanel.Dock="Right" Click="Edit_Click" IsEnabled="{Binding HasSelectedNote}" Padding="8,5" FontSize="11" />
            <TextBlock Text="{Binding LibraryHint}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBox Grid.Row="5" Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0" FontSize="12" Background="#FAFCFC" AutomationProperties.Name="지식 내용 미리보기" />
        </Grid>
      </TabItem>
      <TabItem Header="대화 자동 정리"><local:AutoKnowledgePanel x:Name="Automation" /></TabItem>
      <TabItem Header="연결 설정">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <TextBlock Text="옵시디언 보관함" FontWeight="SemiBold" />
            <TextBlock Text="봇이 읽을 노트가 있는 폴더를 선택하세요. 같은 폴더를 여러 봇과 공유할 수 있습니다." Margin="0,8" FontSize="12" />
            <TextBox Text="{Binding VaultPath, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AutomationProperties.Name="옵시디언 보관함 경로" />
            <WrapPanel>
              <Button Content="폴더 선택" Click="Folder_Click" Padding="10,7" Margin="0,0,6,0" />
              <Button Content="새 보관함" Click="CreateVault_Click" Padding="10,7" Margin="0,0,6,0" />
              <Button Content="폴더 열기" Click="OpenFolder_Click" Padding="10,7" />
            </WrapPanel>
            <CheckBox Content="이 봇의 답변에 지식 노트 사용" IsChecked="{Binding Enabled}" Margin="0,18" />
            <WrapPanel>
              <Button Content="연결 저장" Click="Save_Click" Padding="12,8" Background="#087E83" Foreground="White" Margin="0,0,6,0" />
              <Button Content="모든 봇에 같은 연결 적용" Click="SaveAll_Click" Padding="12,8" />
            </WrapPanel>
            <TextBlock Text="관련 노트 발췌는 답변 생성 시 선택된 AI 서비스에 전달됩니다. 수정·삭제는 다음 질문부터 반영됩니다." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,14" />
            <Separator Margin="0,8,0,16" />
            <TextBlock Text="옵시디언 · 백업" FontWeight="SemiBold" />
            <Button Content="옵시디언 열기" Click="OpenObsidian_Click" HorizontalAlignment="Left" Padding="12,8" Margin="0,10" />
            <TextBlock Text="봇은 옵시디언이 꺼져 있어도 노트를 읽습니다. GitHub 백업을 설정한 보관함은 옵시디언을 켜 두면 설정한 주기에 따라 백업됩니다." FontSize="12" />
            <TextBlock Text="대화를 계속 지식으로 쌓으려면 ‘대화 자동 정리’ 탭에서 방과 주기를 설정하세요. 이전 대화는 AI 챗봇 → 대화분석 → 요약을 노트로 저장으로 추가할 수 있습니다." TextWrapping="Wrap" FontSize="12" Margin="0,16,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#EAF5F5" CornerRadius="6" Padding="10" Margin="0,9,0,0">
      <DockPanel>
        <Button Content="취소" Click="Cancel_Click" DockPanel.Dock="Right" IsEnabled="{Binding Busy}" Padding="8,4" Margin="8,0,0,0" />
        <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" MaxHeight="62" FontSize="11" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
