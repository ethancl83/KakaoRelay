<UserControl x:Class="KakaoRelay.App.PersonaImagesPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="7,4"/>
      <Setter Property="MinWidth" Value="70"/><Setter Property="Height" Value="40"/>
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextAlignment="Center" TextWrapping="NoWrap"/></DataTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="페르소나 이미지 · 관리자" FontSize="17" FontWeight="Bold"/>
        <TextBlock Text="이 앱에서만 생성·변경합니다. 대화 명령과 발송 API로는 이미지를 바꿀 수 없습니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,12"/>
        <DockPanel IsEnabled="{Binding Idle}">
          <Button DockPanel.Dock="Right" Content="이 버전&#x0a;적용" Click="ApplyVersion_Click" IsEnabled="{Binding HasReference}" Margin="6,0,0,6"/>
          <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" DisplayMemberPath="Name" AutomationProperties.Name="이미지 버전"/>
        </DockPanel>
        <TextBlock Text="{Binding AppliedLabel}" Foreground="#087E83" FontWeight="SemiBold"/>
        <Expander Header="이미지 생성 CLI" Margin="0,10">
          <StackPanel IsEnabled="{Binding Idle}" Margin="0,8">
            <TextBlock Text="GPT · Codex CLI + imagegen" FontWeight="SemiBold"/>
            <TextBox Text="{Binding GptModel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="GPT 이미지 생성 담당 모델"/>
            <TextBlock Text="Grok CLI · 내장 이미지 생성/편집" FontWeight="SemiBold"/>
            <TextBox Text="{Binding GrokModel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Grok 이미지 생성 담당 모델"/>
            <TextBlock Text="로그인된 CLI 계정을 사용합니다. 실행 파일 경로는 프로바이더 설정을 따릅니다. API 키는 사용하지 않습니다." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </Expander>
        <StackPanel IsEnabled="{Binding Idle}">
          <TextBlock Text="기준 이미지 방향 (선택)"/><TextBox Text="{Binding VisualDirection, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"/>
          <Button Content="기준 이미지&#x0a;스스로 만들기" Click="GenerateReference_Click" HorizontalAlignment="Left"/>
          <TextBlock Text="저장된 페르소나로 자신의 외형을 정합니다. 새 기준은 후보로 보관하며, 채택할 때 해당 버전의 표정 선택이 초기화됩니다." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,10"/>
        </StackPanel>
        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,6,0"><TextBlock Text="현재 기준" FontWeight="SemiBold"/><Border Background="#F3F7F7" Margin="0,6"><Image Source="{Binding ReferencePreview}" Height="155" Stretch="Uniform"/></Border></StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="선택한 후보" FontWeight="SemiBold"/><Border Background="#F3F7F7" Margin="0,6"><Image Source="{Binding SelectedPreview}" Height="155" Stretch="Uniform"/></Border></StackPanel>
        </Grid>
        <WrapPanel IsEnabled="{Binding Idle}">
          <ComboBox ItemsSource="{Binding Expressions}" SelectedItem="{Binding SelectedExpression}" DisplayMemberPath="Name" Width="80" Margin="0,0,6,6"/>
          <Button Content="이 감정&#x0a;생성·재생성" Click="GenerateExpression_Click" IsEnabled="{Binding HasReference}" Margin="0,0,6,6"/>
          <Button Content="없는 감정&#x0a;모두 생성" Click="GenerateMissing_Click" IsEnabled="{Binding HasReference}" Margin="0,0,0,6"/>
        </WrapPanel>
        <TextBlock Text="기본 · 기쁨 · 슬픔 · 놀람 · 화남 · 생각 · 응원. 모든 재생성은 현재 기준 이미지를 참조하며 기존 결과를 보관합니다." FontSize="11" Foreground="{StaticResource Muted}"/>
        <ListBox ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}" Height="180" Margin="0,10" IsEnabled="{Binding Idle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate><DataTemplate><StackPanel Width="125" Margin="3"><Image Source="{Binding Thumbnail}" Width="100" Height="95" Stretch="Uniform"/><TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="10"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{Binding SelectedDetail}" FontSize="11" Foreground="{StaticResource Muted}"/>
        <Expander x:Name="MagentaExpander" Header="마젠타 투명화" IsExpanded="False" Margin="0,10,0,0" IsEnabled="{Binding Idle}">
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding MagentaTolerance, StringFormat=F0}" MinWidth="28" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MagentaTolerance}" VerticalAlignment="Center" AutomationProperties.Name="마젠타 색상 허용 오차"/>
            <Button Grid.Column="2" Content="적용" Click="MakeTransparent_Click" IsEnabled="{Binding HasSelection}" Height="30" Margin="8,0,0,0"/>
          </Grid>
        </Expander>
        <Expander x:Name="PromptExpander" Header="생성 프롬프트" IsExpanded="False" Margin="0,10,0,0">
          <StackPanel Margin="0,8,0,0">
            <TextBox Text="{Binding SelectedPrompt, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="150" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="선택 이미지 생성 프롬프트"/>
            <Button Content="복사" Click="CopyPrompt_Click" IsEnabled="{Binding HasPrompt}" Height="30" HorizontalAlignment="Right"/>
          </StackPanel>
        </Expander>
        <WrapPanel IsEnabled="{Binding Idle}" Margin="0,8">
          <Button Content="선택 이미지&#x0a;채택" Click="UseImage_Click" IsEnabled="{Binding HasSelection}" Margin="0,0,6,6"/>
          <Button Content="선택 이미지&#x0a;삭제" Click="DeleteImage_Click" IsEnabled="{Binding HasSelection}" Margin="0,0,6,6"/>
          <Button Content="이미지 폴더&#x0a;열기" Click="OpenFolder_Click" Margin="0,0,0,6"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Background="#EAF5F5" Padding="8" Margin="0,8,0,0"><DockPanel>
      <Button DockPanel.Dock="Right" Content="작업&#x0a;중지" Click="Cancel_Click" IsEnabled="{Binding Busy}" Margin="6,0,0,0"/>
      <StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0" Visibility="{Binding ProgressVisibility}"/></StackPanel>
    </DockPanel></Border>
  </Grid>
</UserControl>
